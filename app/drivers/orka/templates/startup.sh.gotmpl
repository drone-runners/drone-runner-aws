#!/usr/bin/env bash
set -e
mkdir -p /tmp/certs/


mkdir -p /opt/homebrew/bin /usr/local/bin


curl_retry() {
    local url="$1" dest="$2" tries="$3" delay="$4"
    local attempt=1
    while [ "$attempt" -le "$tries" ]; do
        if curl -fsSL "$url" -o "$dest"; then
            return 0
        fi
        attempt=$((attempt + 1))
        sleep "$delay"
    done
    return 1
}

echo {{ .CACert | base64 }} | base64 -d >> {{ .CaCertPath }}
chmod 0600 {{ .CaCertPath }}

echo {{ .TLSCert | base64 }} | base64 -d  >> {{ .CertPath }}
chmod 0600 {{ .CertPath }}

echo {{ .TLSKey | base64 }} | base64 -d >> {{ .KeyPath }}
chmod 0600 {{ .KeyPath }}

if curl_retry "{{ .LiteEnginePath }}/lite-engine-{{ .Platform.OS }}-{{ .Platform.Arch }}" /opt/homebrew/bin/lite-engine 3 3; then
    echo "Successfully downloaded lite engine binary from primary URL."
else
    echo "Primary URL failed for lite-engine. Trying fallback URL..."
	if curl_retry "{{ .LiteEngineFallbackPath }}/lite-engine-{{ .Platform.OS }}-{{ .Platform.Arch }}" /opt/homebrew/bin/lite-engine 10 3; then
        echo "Successfully downloaded lite engine binary from fallback URL."
    else
        echo "Failed to download lite-engine from both URLs."
        exit 1
    fi
fi
chmod 777 /opt/homebrew/bin/lite-engine

# Orka's bootstrap LaunchDaemon runs this script under launchd, where $HOME is not
# reliably the root home directory (observed /Users/admin instead of /var/root on a
# real trial VM). Hardcode /var/root instead of trusting inherited $HOME.
mkdir -p /var/root
touch /var/root/.env
echo "SKIP_PREPARE_SERVER=true" >> /var/root/.env

{{ if .PluginBinaryURI }}
if curl_retry "{{ .PluginBinaryURI }}/plugin-{{ .Platform.OS }}-{{ .Platform.Arch }}" /usr/local/bin/plugin 3 3; then
    echo "Successfully downloaded plugin binary from primary URL."
else
    echo "Primary URL failed for plugin. Trying fallback URL..."
	if curl_retry "{{ .PluginBinaryFallbackURI }}/plugin-{{ .Platform.OS }}-{{ .Platform.Arch }}" /usr/local/bin/plugin 10 10; then
        echo "Successfully downloaded plugin binary from fallback URL."
    else
        echo "Failed to download plugin binary from both URLs."
        exit 1
    fi
fi
chmod 777 /usr/local/bin/plugin

{{ if .Tmate.Enabled }}
mkdir -p /tmp/addon
if curl -fsSL {{ .TmateBinaryURI }}tmate-1.0-static-mac-arm64.tar.xz -o /tmp/addon/tmate.xz; then
	echo "Successfully downloaded tmate binary from primary URL."
else
	echo "Primary URL failed for tmate. Trying fallback URL..."
	curl -fsSL {{ .TmateBinaryFallbackURI }}tmate-1.0-static-mac-arm64.tar.xz -o /tmp/addon/tmate.xz
	echo "Successfully downloaded tmate binary from fallback URL."
fi
tar -xf /tmp/addon/tmate.xz -C /tmp/addon/
chmod 777  /tmp/addon/tmate-1.0-static-mac-arm64/tmate
mv  /tmp/addon/tmate-1.0-static-mac-arm64/tmate /tmp/addon/tmate
{{ end }}

{{ end }}

if curl -fL {{ .EnvmanBinaryURI }}envman-Darwin-arm64 > /usr/local/bin/envman; then
	echo "Successfully downloaded envman binary from primary URL."
else
	echo "Primary URL failed for envman. Trying fallback URL..."
	curl -fL {{ .EnvmanBinaryFallbackURI }}envman-Darwin-arm64 > /usr/local/bin/envman
	echo "Successfully downloaded envman binary from fallback URL."
fi
chmod 777 /usr/local/bin/envman

{{ if .AnnotationsBinaryURI }}
if curl_retry "{{ .AnnotationsBinaryURI }}hcli-{{ .Platform.OS }}-{{ .Platform.Arch }}" /usr/local/bin/hcli 3 3; then
    echo "Successfully downloaded annotations CLI from primary URL."
else
    echo "Primary URL failed for annotations CLI. Trying fallback URL..."
    if curl_retry "{{ .AnnotationsBinaryFallbackURI }}hcli-{{ .Platform.OS }}-{{ .Platform.Arch }}" /usr/local/bin/hcli 10 3; then
        echo "Successfully downloaded annotations CLI from fallback URL."
    else
        echo "Failed to download annotations CLI from both URLs."
    fi
fi
chmod 755 /usr/local/bin/hcli
{{ end }}

{{ if .AutoInjectionBinaryURI }}
mkdir -p /tmp/harness/bin
curl_retry "{{ .AutoInjectionBinaryURI }}/{{ .Platform.OS }}/{{ .Platform.Arch }}/auto-injection" /tmp/harness/bin/auto-injection 10 10
chmod 777 /tmp/harness/bin/auto-injection
{{ end }}

{{ if .HarnessTestBinaryURI }}
    if curl_retry "{{ .HarnessTestBinaryURI }}/{{ .Platform.Arch }}/{{ .Platform.OS }}/bin/split_tests-{{ .Platform.OS }}_{{ .Platform.Arch }}" /usr/local/bin/split_tests 10 3; then
        echo "Successfully downloaded split test binary URL."
        chmod 777 /usr/local/bin/split_tests
    else
        echo "Failed to download split test binary"
    fi
{{ end }}

# Unlike the regular cloud-init path (anka/GCP/etc.), this script runs once per Orka
# VM boot via our own orka-bootstrap LaunchDaemon, not via a persistent init-managed
# shell session - so backgrounding lite-engine with `&` here would not survive a
# reboot or a bootstrap-daemon exit. Install it as its own KeepAlive LaunchDaemon
# instead, matching what was validated live on the trial VM.
cat > /Library/LaunchDaemons/com.harness.lite-engine.plist <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.harness.lite-engine</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/lite-engine</string>
        <string>server</string>
        <string>--env-file</string>
        <string>/var/root/.env</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/var/root</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/root/lite-engine.log</string>
    <key>StandardErrorPath</key>
    <string>/var/root/lite-engine.log</string>
</dict>
</plist>
PLIST
chown root:wheel /Library/LaunchDaemons/com.harness.lite-engine.plist
chmod 644 /Library/LaunchDaemons/com.harness.lite-engine.plist
launchctl print system/com.harness.lite-engine >/dev/null 2>&1 || launchctl bootstrap system /Library/LaunchDaemons/com.harness.lite-engine.plist
