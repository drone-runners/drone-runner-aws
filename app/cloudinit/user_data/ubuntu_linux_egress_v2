#cloud-config
# Egress-control cloud-init (proxy variant). Deltas vs ubuntu_linux: bakes the
# Harness Egress CA, points Docker + the host env at the fleet forward-proxy
# (172.16.0.11:3128), verifies proxy reachability, then starts lite-engine last
# so all outbound HTTP/S flows through the fleet. Leaner than ubuntu_linux: no
# apt install and no EnableC4D NVMe setup (assumes a baked image).
bootcmd:
  - mkdir -p /var/log
  - touch /var/log/nvme-setup.log
  - echo "NVME setup is disabled. Skipping NVME disk detection." >> /var/log/nvme-setup.log
# Certificate files
write_files:
- path: {{ .CaCertPath }}
  permissions: '0600'
  encoding: b64
  content: {{ .CACert | base64 }}
- path: {{ .CertPath }}
  permissions: '0600'
  encoding: b64
  content: {{ .TLSCert | base64 }}
- path: {{ .KeyPath }}
  permissions: '0600'
  encoding: b64
  content: {{ .TLSKey | base64 }}

# Harness Egress CA (signs the on-demand leaf certs the fleet presents).
# Single source: dropped under /usr/local/share/ca-certificates so
# update-ca-certificates folds it into /etc/ssl/certs/ca-certificates.crt.
# That's what curl/pip/git/openssl-using tools trust by default, AND what
# REQUESTS_CA_BUNDLE/GIT_SSL_CAINFO/SSL_CERT_FILE point at below.
# Node is the one consumer that doesn't merge with the system bundle --
# NODE_EXTRA_CA_CERTS in /etc/environment points directly at this same file.
- path: /usr/local/share/ca-certificates/harness-ca.crt
  permissions: '0644'
  encoding: b64
  content: {{ .EgressCACert | base64 }}

- path: /etc/harness-certs/ca.crt
  permissions: '0644'
  encoding: b64
  content: {{ .EgressCACert | base64 }}

# Main runtime commands
runcmd:
  # Enable command tracing
  - set -x

  # Configure Google DNS for hosted builds
  - echo "DNS=8.8.8.8 8.8.4.4\nFallbackDNS=1.1.1.1 1.0.0.1\nDomains=~." | sudo tee -a /etc/systemd/resolved.conf
  - systemctl restart systemd-resolved

  # Open healthcheck port
  - ufw allow 9079

{{ template "ubuntu_binaries" . }}


  # ────────────────────────────────────────────────────────────────────
  # ALL bootstrap downloads done. Trust the Harness Egress CA.
  # Proxy configuration (docker systemd drop-in + /etc/environment) is
  # applied by lite-engine at setup time so that per-account credentials
  # can be embedded. See lite-engine handler/setup.go applyDockerProxy.
  # ────────────────────────────────────────────────────────────────────
  - update-ca-certificates

  # Egress proxy reachability check. Fails the build VM bootstrap if the
  # fleet ILB is not reachable on the proxy port. /healthz on :3128 is a
  # direct_response 200 from Envoy — short-circuits before TPA, so it
  # works regardless of TPA allowlist state and is sub-ms when the
  # listener is up. We retry briefly to ride out a fleet pod restart.
  - |
    ok=0
    for i in 1 2 3 4 5; do
      code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 {{ .EgressProxyURL }}/healthz || true)
      if [ "$code" = "200" ]; then
        echo "[egress] proxy /healthz=200 (attempt $i)"
        ok=1
        break
      fi
      echo "[egress] proxy /healthz=$code (attempt $i/10) — retrying"
      sleep 3
    done
    if [ "$ok" != "1" ]; then
      echo "[egress] FATAL: proxy /healthz failed after 10 attempts; aborting bootstrap" >&2
      exit 1
    fi

  # Start lite-engine (last step — proxy already armed above).
  - touch /root/.env
  - '[ -f "/etc/environment" ] && cp "/etc/environment" /root/.env'
  - echo "CLOUD_DRIVER={{ .DriverName }}" >> /root/.env
  - /usr/bin/lite-engine server --env-file /root/.env > /var/log/lite-engine.log 2>&1 &
