# First Stage: Build environment with Go and dependencies
FROM harness0.harness.io/oci/docker_artifacts/golang:1.26.10-alpine@sha256:27f2d3b83cfc5803c8078f8e730af0f7c431bf067afaec8f60a36fb763187cba as builder
RUN apk --no-cache add 'ca-certificates>=20261020-r0' git build-base
WORKDIR /app
COPY . .
USER root
# Fetch dependencies
RUN go mod download && export GOPATH=""

# Build the application
RUN CGO_ENABLED=1 go build -ldflags "-extldflags \"-static\"" -o /app/drone-runner-aws
#Second Stage: Final lightweight image
FROM harness0.harness.io/oci/docker_artifacts/alpine:3.23.7@sha256:ff7f0c727dd796aa36787bfcd9a64bf35a6ce72a73451b3359fde849b6703d63
WORKDIR /app
RUN chown -R nobody:nobody /app
RUN apk --no-cache add 'ca-certificates>=20261020-r0'
RUN update-ca-certificates --fresh
RUN touch database.sqlite3 && chmod 777 /app/database.sqlite3
COPY --from=builder /app/drone-runner-aws ./drone-runner-aws
RUN chmod 777  ./drone-runner-aws
EXPOSE 3000
ENTRYPOINT ["/app/drone-runner-aws"]
