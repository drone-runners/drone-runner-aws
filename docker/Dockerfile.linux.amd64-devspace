# First Stage: Build environment with Go and dependencies
FROM harness0.harness.io/oci/docker_artifacts/hhi/go:1.27.3-dev@sha256:58aeee00b259a403aaef3fcfd36ede300e519ae794c15f6ed2a759d94bbeced7 as builder
WORKDIR /app
COPY . .
USER root
# Fetch dependencies
RUN go mod download && export GOPATH=""

# Build the application
RUN CGO_ENABLED=1 go build -ldflags "-extldflags \"-static\"" -o /app/drone-runner-aws
#Second Stage: Final lightweight image
FROM harness0.harness.io/oci/docker_artifacts/hhi/harnessos-alpine:1@sha256:290a37c85b4284d2c11fa0778e5da79643d912a1f5a57d6f701b77644503b7e7
WORKDIR /app
RUN chown -R nobody:nobody /app
RUN apk --no-cache add 'ca-certificates>=20261020-r0' wget libc-bin
RUN update-ca-certificates --fresh
RUN touch database.sqlite3 && chmod 777 /app/database.sqlite3
COPY --from=builder /app/drone-runner-aws ./drone-runner-aws
RUN chmod 777  ./drone-runner-aws
EXPOSE 3000
ENTRYPOINT ["/app/drone-runner-aws"]
