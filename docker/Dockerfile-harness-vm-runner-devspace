FROM harness0.harness.io/oci/docker_artifacts/hhi/harnessos-alpine:1 AS incident-ca
RUN apk add --no-cache 'ca-certificates>=20261020-r0'

# First Stage: Build environment with Go and dependencies
FROM harness0.harness.io/oci/docker_artifacts/golang:1.26.10 as builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git && \
    rm -rf /var/lib/apt/lists/*

COPY --from=incident-ca /usr/share/ca-certificates/ /usr/share/ca-certificates/
COPY --from=incident-ca /etc/ca-certificates.conf /etc/ca-certificates.conf
RUN update-ca-certificates --fresh

WORKDIR /app

# Copy go module files first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application
# CGO is required for sqlite3 support
RUN CGO_ENABLED=1 go build -ldflags "-extldflags \"-static\"" -o /app/harness-vm-runner
#Second Stage: Final lightweight image
FROM us-west1-docker.pkg.dev/gar-setup/docker/alpine:3.23.3
WORKDIR /app
RUN chown -R nobody:nobody /app
RUN apk --no-cache add ca-certificates
COPY --from=incident-ca /usr/share/ca-certificates/ /usr/share/ca-certificates/
COPY --from=incident-ca /etc/ca-certificates.conf /etc/ca-certificates.conf
RUN update-ca-certificates --fresh
RUN touch database.sqlite3 && chmod 777 /app/database.sqlite3
COPY --from=builder /app/harness-vm-runner ./harness-vm-runner
RUN chmod 777  ./harness-vm-runner
EXPOSE 3000
ENTRYPOINT ["/app/harness-vm-runner"]
