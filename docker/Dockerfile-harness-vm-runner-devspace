# First Stage: Build environment with Go and dependencies
FROM harness0.harness.io/oci/docker_artifacts/golang:1.26.10@sha256:672c944cfd07599b5f1bb179869270cdc94c6254e41db4d431259693cb286b82 as builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy go module files first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application
# CGO is required for sqlite3 support
RUN CGO_ENABLED=1 go build -ldflags "-extldflags \"-static\"" -o /app/harness-vm-runner
#Second Stage: Final lightweight image
FROM harness0.harness.io/oci/docker_artifacts/alpine:3.23.7@sha256:ff7f0c727dd796aa36787bfcd9a64bf35a6ce72a73451b3359fde849b6703d63
WORKDIR /app
RUN chown -R nobody:nobody /app
RUN apk --no-cache add 'ca-certificates>=20261020-r0'
RUN update-ca-certificates --fresh
RUN touch database.sqlite3 && chmod 777 /app/database.sqlite3
COPY --from=builder /app/harness-vm-runner ./harness-vm-runner
RUN chmod 777  ./harness-vm-runner
EXPOSE 3000
ENTRYPOINT ["/app/harness-vm-runner"]
