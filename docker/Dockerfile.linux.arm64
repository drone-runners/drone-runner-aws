FROM harness0.harness.io/oci/docker_artifacts/hhi/harnessos-alpine:1@sha256:290a37c85b4284d2c11fa0778e5da79643d912a1f5a57d6f701b77644503b7e7
RUN apk update && apk upgrade --no-cache && apk add --no-cache wget libc-bin

EXPOSE 3000

ENV GODEBUG netdns=go
ENV DRONE_PLATFORM_OS linux
ENV DRONE_PLATFORM_ARCH arm64

LABEL com.centurylinklabs.watchtower.stop-signal="SIGINT"

ADD release/linux/arm64/drone-runner-aws-linux-arm64 /bin/drone-runner-aws

ENTRYPOINT ["/bin/drone-runner-aws"]
